{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "lib": ["ES2022", "DOM", "ESNext.Disposable"],
        "skipLibCheck": true,
        "customConditions": ["nestrum-source"],
        "types": ["node"]
    },
    "include": ["packages/*/src/**/*.ts", "packages/*/tests/**/*.ts", "vitest.config.ts", "vitest.workspace.ts"],
    "exclude": ["packages/admin-ui"]
}
