{
    "name": "@nestrum/admin-ui",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": {
            "nestrum-source": "./src/lib/index.ts",
            "types": "./dist/lib/index.d.ts",
            "import": "./dist/lib/index.js"
        },
        "./node": {
            "nestrum-source": "./src/node/index.ts",
            "types": "./dist/node/index.d.ts",
            "import": "./dist/node/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "svelte-kit sync && vite build && pnpm --workspace-root exec tsc -p packages/admin-ui/tsconfig.build.json",
        "check": "svelte-kit sync && svelte-check-native --tsconfig tsconfig.json --fail-on-warnings",
        "verify:build": "node tooling/verify-build.mjs",
        "dev": "vite dev"
    },
    "dependencies": {
        "@nestrum/admin": "workspace:*",
        "@nestrum/hono": "workspace:*",
        "@sveltejs/kit": "2.70.3",
        "svelte": "5.57.1",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "svelte-check-native": "1.8.0",
        "typescript": "6.0.3",
        "vite": "8.3.1"
    }
}
