{
    "extends": "./.svelte-kit/tsconfig.json",
    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "allowJs": true,
        "checkJs": true,
        "skipLibCheck": true,
        "moduleResolution": "bundler",
        "rewriteRelativeImportExtensions": true,
        "customConditions": ["nestrum-source"]
    }
}
