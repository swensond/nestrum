{
    "name": "@nestrum/cli",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "bin": {
        "nestrum": "./dist/bin.js"
    },
    "exports": {
        ".": {
            "nestrum-source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "verify:build": "node tooling/verify-build.mjs"
    },
    "dependencies": {
        "@nestrum/core": "workspace:*",
        "@nestrum/prisma": "workspace:*"
    }
}
