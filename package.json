{
    "name": "nestrum",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.6.0",
    "engines": {
        "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
    },
    "scripts": {
        "build": "pnpm -r build",
        "test": "vitest run",
        "test:watch": "vitest --watch",
        "test:integration": "pnpm build && pnpm --filter @nestrum/example integration",
        "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @nestrum/admin-ui check",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "check": "pnpm test && pnpm typecheck && pnpm build && pnpm --filter @nestrum/admin-ui verify:build && pnpm --filter @nestrum/cli verify:build"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@nestrum/cli": "workspace:*",
        "@types/node": "26.6.3",
        "typescript": "7.0.2",
        "vitest": "5.0.2"
    }
}
